<launch>
    <let name="robot_path" value="$(find-pkg-share mini_project_description)/urdf/robot.urdf.xacro"/>

    <let name="rviz_path" value="$(find-pkg-share mini_project_bringup)/config/rvizconfig.rviz"/>

    <let name="slam_toolbox_launch_file" value="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py"/>

    <let name="slam_toolbox_params" value="$(find-pkg-share mini_project_bringup)/config/slam_toolbox_params.yaml"/>

    <let name="nav2_params" value="$(find-pkg-share mini_project_bringup)/config/nav2_params.yaml"/>

    <let name="nav2_launch_file" value="$(find-pkg-share nav2_bringup)/launch/bringup_launch.py"/>

    <let name="world_path" value="$(find-pkg-share mini_project_description)/worlds/colored_warehouse.sdf"/>

    <let name="map" value="$(find-pkg-share mini_project_bringup)/maps/warehouse_world.yaml"/>

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var robot_path)')"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
         <arg name="gz_args" value="$(var world_path) -r"/>
    </include>

    

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -name robot" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>
    
    <node pkg="rviz2" exec="rviz2" args="-d $(var rviz_path)" output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- <include file="$(var slam_toolbox_launch_file)">
        <arg name="slam_params_file" value="$(var slam_toolbox_params)"/>
        <arg name="use_sim_time" value="true"/>
    </include> -->

    <!-- <node pkg="tf2_ros" exec="static_transform_publisher" args="0 0 0 0 0 0 base_footprint base_scan" /> -->

    <include file="$(var nav2_launch_file)">
    <arg name="params_file" value="$(var nav2_params)"/>
    <arg name="map" value="$(var map)"/>
    <arg name="use_sim_time" value="true"/>
</include>
    <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
        <param name="config_file" value="$(find-pkg-share mini_project_bringup)/config/gazebo_bridge.yaml"/>
        <param name="use_sim_time" value="true"/>
    </node>
</launch>
