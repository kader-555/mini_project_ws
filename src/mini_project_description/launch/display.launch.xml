<launch>
    <!-- Robot State Publisher Node  -->
    <let  name="robot_path" value="$(find-pkg-share mini_project_description)/urdf/robot.urdf.xacro"/>
    <node pkg="robot_state_publisher"  exec="robot_state_publisher">
        <param  name="robot_description" value="$(command 'xacro $(var robot_path)')"/>
    </node>

    <!-- GUI -->
    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />
    <!-- RViz Node -->
    <node pkg="rviz2" exec="rviz2" />
</launch>