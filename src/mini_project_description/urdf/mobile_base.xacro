<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="${pi / 2} 0.0 0.0"/>
                <material name="black"/>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="${pi / 2} 0.0 0.0"/>  
            </collision>
            <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" l="${wheel_length}" o_xyz="0.0 0.0 0.0" o_rpy="${pi / 2} 0.0 0.0"/>
        </link>
    </xacro:macro>


    <link name="base_footprint" />
    <!-- Base link  -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_width} ${base_length} ${base_height}"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="white"/>
        </visual>
        <collision>
            <geometry>
                <box size="${base_width} ${base_length} ${base_height}"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <xacro:box_inertia m="${base_mass}" x="${base_width}" y="${base_length}" z="${base_height}" o_xyz="0.0 0.0 0.0" o_rpy="0.0 0.0 0.0"/>
    </link>
    <link  name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius = "${caster_radius}" />
            </geometry>
            <origin xyz = "0 0 0" rpy="0 0 0"/>
            <material name = "black"/>
        </visual>
        <collision>
                <geometry>
                    <sphere radius="${caster_radius}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                 </collision>
        <xacro:sphere_inertia m="0.5" r="${caster_radius}"  o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>
    <link name="screen_link">
        <visual>
            <geometry>
                <box size="${screen_width} ${screen_length} ${screen_height}"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="black"/>
        </visual>
    </link>

    <link name="base_scan">
        <visual>
            <geometry>
                <cylinder radius="${scanner_radius}" length="${scanner_length}"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name="red"/>
        </visual>
        <collision>
                <geometry>
                    <cylinder radius="${scanner_radius}" length="${scanner_length}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${scanner_radius}" l="${scanner_length}" o_xyz="0.0 0.0 0.0" o_rpy="0.0 0.0 0.0"/>
    </link>

    <xacro:wheel_link prefix="right"/>
    
    <xacro:wheel_link prefix="left"/>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="${-base_width/4} ${-base_length/2 - wheel_length / 2} ${- base_height/2}" rpy="0.0 0.0 0.0"/>
        <axis xyz = "0 1 0" />
    </joint>
    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="${-base_width/4} ${+base_length/2 + wheel_length / 2} ${- base_height/2}" rpy="0.0 0.0 0.0"/>
        <axis xyz = "0 1 0" />
    </joint>
    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel_link"/>
        <origin xyz="${base_width/2 - caster_radius} 0.0 ${-(base_height/2 + caster_radius)}" rpy="0.0 0.0 0.0"/>
        
    </joint>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 ${2*caster_radius + base_height/2}" rpy="0.0 0.0 0.0"/>
    </joint>
    <joint name="base_screen_joint" type="fixed">
        <parent link="base_link"/>
        <child link="screen_link"/>
        <origin xyz="${base_width/2} 0.0 ${base_height/2 - screen_height}" rpy="0.0 0.0 0.0"/>
    </joint>
    <joint name="base_scan_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_scan"/>
        <origin xyz="0.0 0.0 ${base_height/2 + scanner_length/2}" rpy="0.0 0.0 0.0"/>
    </joint>
</robot>